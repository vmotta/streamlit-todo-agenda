# Copie somente os valores necessários para os Secrets do Streamlit Cloud.
# Nunca versione o arquivo real nem uma connection string válida.
DATABASE_URL = "postgresql://usuario:senha@servidor-pooler.neon.tech/neondb?sslmode=require"
ENVIRONMENT = "production"
AUTH_MODE = "none"
DEFAULT_TIMEZONE = "America/Sao_Paulo"
LOG_LEVEL = "INFO"

# Se usar OIDC, altere AUTH_MODE para "oidc" e configure esta seção.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "gere-um-segredo-aleatorio-forte"
client_id = "seu-client-id"
client_secret = "seu-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

